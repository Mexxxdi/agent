# Store display name used in WhatsApp confirmation messages
STORE_NAME=

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
VERIFY_TOKEN=

# Shared secret that Google Apps Script sends as header x-webhook-secret
SHEET_WEBHOOK_SECRET=

# Google Sheets (separate spreadsheet files)
RAW_ORDERS_SHEET_ID=
CONFIRMED_ORDERS_SHEET_ID=

# Service account credentials: paste the full JSON as a single line,
# OR set a local file path such as service_account.json
GOOGLE_CREDENTIALS_JSON=
